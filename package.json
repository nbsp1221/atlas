{
  "name": "atlas",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:verification": "node --test scripts/test/*.test.mjs",
    "verify:upgrade": "node scripts/verify-upgrade.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:local": "node scripts/verify-local.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.22.1 || >=24"
  }
}
