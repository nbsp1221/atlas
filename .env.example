# Local development database only; replace for your installation.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/control_plane
API_PORT=3001
ATLAS_LISTEN_HOST=127.0.0.1

# Required for authenticated use. Fill these in your ignored .env; no real secrets here.
# Source root .env into the shell before API/DB commands (see README).
ATLAS_PUBLIC_URL=https://atlas.example.com:3001
ATLAS_AUTH_SECRET=
ATLAS_TLS_CERT_FILE=/absolute/protected/path/cert.pem
ATLAS_TLS_KEY_FILE=/absolute/protected/path/key.pem
ATLAS_WEB_DIST=/absolute/path/to/dedicated/web-build

# Optional Connections encryption: JSON version -> base64 32-byte key.
# Protect key material separately from the database and retain required old versions.
# ATLAS_CREDENTIAL_KEYS_FILE=/absolute/protected/path/credential-keys.json
# ATLAS_CREDENTIAL_ACTIVE_KEY=v1

# Optional Vite-only private hostname belongs in apps/web/.env.local:
# ATLAS_DEV_ALLOWED_HOST=your-private-hostname.example
