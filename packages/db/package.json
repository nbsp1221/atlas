{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "tsx test/schema-verification.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@workspace/automation-runtime": "workspace:*",
    "@workspace/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10",
    "globals": "^17",
    "tsx": "^4.23.15",
    "typescript": "~6",
    "typescript-eslint": "^8"
  }
}
